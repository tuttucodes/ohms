# ──────────────────────────────────────────────────────────────
# OHMS environment configuration
# Copy to .env.local and fill in. The app runs with ZERO config
# (bundled catalogue + file-backed orders + test-mode checkout).
# Add these to enable production features.
# ──────────────────────────────────────────────────────────────

# Public site URL (used for SEO/OG/metadata)
NEXT_PUBLIC_SITE_URL=https://ohms.example.com

# Optional: serve product images from a self-hosted origin instead of the
# default CDN. After running scripts/download-images.mjs + uploading.
# NEXT_PUBLIC_IMAGE_BASE=https://your-bucket.supabase.co/storage/v1/object/public/product-images

# ── Admin dashboard ──
# Password to sign in at /admin/login (default dev password: ohms-admin)
ADMIN_PASSWORD=change-this-admin-password
# Secret used to sign admin session cookies (use a long random string)
ADMIN_SESSION_SECRET=generate-a-long-random-secret

# ── Razorpay (payments) ──
# From the Razorpay dashboard. Without these, checkout runs in test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: for the /api/razorpay/webhook endpoint
RAZORPAY_WEBHOOK_SECRET=

# ── Supabase (durable products + orders) ──
# Without these, orders persist to a local file (.data/orders.json) and the
# catalogue is the bundled seed. Configure for production / multi-instance.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
